{
  "manifest_version": 3,
  "name": "GitHub Enhanced View",
  "version": "1.0.0",
  "description": "Local-first enhancements for GitHub repositories.",
  "icons": {
    "16": "dist/icons/extension/icon-16.png",
    "32": "dist/icons/extension/icon-32.png",
    "48": "dist/icons/extension/icon-48.png",
    "128": "dist/icons/extension/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/icons/*.svg"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
