{
  "name": "github-enhanced-view",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first enhancements for GitHub repositories.",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit && vite build --mode content && vite build --mode options",
    "dev": "vite build --mode content --watch",
    "dev:options": "vite build --mode options --watch"
  },
  "keywords": [
    "github",
    "chrome-extension",
    "developer-tools"
  ],
  "author": "Petr Šafrata",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5",
    "vite": "^6.4.1"
  }
}